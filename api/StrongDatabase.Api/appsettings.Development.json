{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Information",
        "Microsoft.EntityFrameworkCore": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Information",
        "StrongDatabase": "Debug"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext}: {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      },
      {
        "Name": "Debug"
      }
    ]
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=primary-db;Port=3306;Database=strongdatabase;Uid=mysql_user;Pwd=mysql_pass;CharSet=utf8mb4;",
    "Replica1": "Server=replica1-db;Port=3306;Database=strongdatabase;Uid=mysql_user;Pwd=mysql_pass;CharSet=utf8mb4;",
    "Replica2": "Server=replica2-db;Port=3306;Database=strongdatabase;Uid=mysql_user;Pwd=mysql_pass;CharSet=utf8mb4;",
    "Standby": "Server=standby-db;Port=3306;Database=strongdatabase;Uid=mysql_user;Pwd=mysql_pass;CharSet=utf8mb4;"
  },
  "ElasticConfiguration": {
    "Uri": "http://elasticsearch:9200"
  }
}
